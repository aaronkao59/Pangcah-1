{
    "1-1": {
        "translation": "你們家有多少人？",
        "reference": "Tatolo. 或者 Tatolo ko tamdaw no loma' niyam.(三位。 我們家的人有三位)"
    },
    "1-2": {
        "translation": "你很高嗎？",
        "reference": "Hay, takaraw kako. (是的，我很高。)"
    },
    "1-3": {
        "translation": "你爸爸會說阿美語嗎？",
        "reference": "Hay, mafana'. (是的，知道。)"
    },
    "1-4": {
        "translation": "你們家在哪裏？",
        "reference": "I Tawyen. (在桃園。)"
    },
    "1-5": {
